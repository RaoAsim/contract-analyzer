# Copy to .env and fill in. NEVER commit .env. None of these may use the NEXT_PUBLIC_ prefix:
# they are read only on the server.

# ── Supabase ────────────────────────────────────────────────────────────────
# Dashboard → Connect → "Session pooler" string (IPv4-friendly, supports prepared statements)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<session-pooler-host>:5432/postgres
# Max DB connections from this app (keep within your Supabase pooler's client limit)
DATABASE_POOL_MAX=8
SUPABASE_URL=https://<project-ref>.supabase.co
# Secret key (sb_secret_…): Dashboard → Settings → API Keys. Server-only; bypasses RLS; used ONLY
# for Storage. (A legacy service_role JWT in SUPABASE_SERVICE_ROLE_KEY still works; legacy keys are
# being retired by Supabase, so prefer the new secret key.)
SUPABASE_SECRET_KEY=replace-me
SUPABASE_STORAGE_BUCKET=documents

# ── Gemini (Google AI Studio → Get API key) ──────────────────────────────────
GEMINI_API_KEY=replace-me
# Any Gemini text model with function calling + JSON output. The alias tracks the current Flash;
# pin a specific model id (e.g. a Flash-Lite model) for predictable cost.
GEMINI_MODEL=gemini-flash-latest
# Thinking tokens count against the output cap. minimal | low | medium | high | default
# (minimal is not supported on every model).
GEMINI_THINKING_LEVEL=low
GEMINI_THINKING_HEADROOM_TOKENS=2048
# Optional: override the API endpoint (proxy / local test double). Leave empty normally.
GEMINI_BASE_URL=

# ── Behaviour / budgets ─────────────────────────────────────────────────────
# Max document tokens sent in one answer call. Deliberately small so large contracts use the
# retrieval / full-scan strategy even on models with big context windows.
CONTEXT_BUDGET_TOKENS=20000
SCAN_WINDOW_TOKENS=8000
SCAN_CONCURRENCY=4
AGENT_MAX_ROUNDS=8
AGENT_MAX_TOOL_CALLS=20
# Supabase's free plan caps a Storage upload at 50 MB; keep this ≤ your plan's limit
MAX_UPLOAD_MB=50
MAX_PAGES=500
RUN_WORKER=true
# Enables demo-only toggles such as ?debugInjectFakeQuote=1. Keep false in normal use.
ENABLE_DEBUG_TOGGLES=false
